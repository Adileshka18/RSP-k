# Шаблон настроек. Скопируйте в .env и заполните своими значениями:
#   copy .env.example .env      (Windows)


# ── PostgreSQL ──────────────────────────────────
# Обязательные: DB_HOST, DB_USER, DB_PASSWORD, DB_NAME — без них backend не запустится.
# DB_HOST/DB_PORT здесь — для запуска backend на своём компьютере (БД из Docker
# проброшена на порт 5440). В docker-compose сервис app сам подставляет db:5432.
DB_HOST=localhost
DB_PORT=5440
DB_USER=postgres
# Без символов @ : / ? # — пароль подставляется в URL для сервиса migrate
DB_PASSWORD=change-me
DB_NAME=savorlink
# Максимум соединений в пуле (по умолчанию 10)
DB_MAX_CONNS=10

# ── Backend ─────────────────────────────────────
AUTH_TOKEN_SECRET=change-me-in-production
AUTH_TOKEN_TTL_SECONDS=604800
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
BACKEND_RELOAD=false
BACKEND_LOG_LEVEL=info
SQL_ECHO=false

# ── Frontend ────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8082
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8082
